# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. .env 는 git 에 올라가지 않아요.
# 서버가 요청할 때마다 .env 를 다시 읽어서, 저장하면 1분 안에 대시보드 'API 연결'에 반영돼요.

# OpenAI (유료) — 콘텐츠 제작 · 표현 검수 AI 2차 검토 · 성과 분석 제안 · 시장 인사이트 요약
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 공공데이터포털 (무료) — 기상청 단기예보 + 한국천문연구원 특일 정보 (활용신청 두 개, 키는 하나)
#   https://www.data.go.kr/data/15084084/openapi.do
#   https://www.data.go.kr/data/15012690/openapi.do
DATA_GO_KR_KEY=

# 한국은행 ECOS (무료) — 의류 · 신발 소비자물가. 비워 두면 sample 키로 동작
#   https://ecos.bok.or.kr/api/
ECOS_API_KEY=

# KOSIS 국가통계포털 (무료) — 온라인쇼핑 상품군별 거래액
#   https://kosis.kr/openapi/
KOSIS_API_KEY=
# KOSIS_TBL_ID=DT_1KE10041

# YouTube Data API v3 (무료 · 하루 10,000 units)
#   https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
